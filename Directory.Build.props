<Project>
  <PropertyGroup>
    <!-- The one version of app, addon and extension (tools/*.ps1 read it). A working build shows 0.1.0-dev+<short
         commit>, a nightly 0.1.0-nightly.<short commit>, a build of the tag v0.1.0 just 0.1.0 (StampBuildVersion). -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <DebugType>embedded</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Tomas Bouda</Authors>
    <Product>ForeverTV</Product>
  </PropertyGroup>
</Project>
